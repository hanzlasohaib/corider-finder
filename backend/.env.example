# General
APP_NAME=CoRide Finder
ENV=development
DEBUG=true

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://coride:coridestrongpassword@localhost:5432/coride_finder

# Auth — use a unique value of at least 16 characters.
# Production will refuse placeholders like change-me-in-production.
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins. Defaults to Vite local URLs if unset.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
